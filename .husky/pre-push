#!/usr/bin/env sh
# Runs on every `git push` from the host. Mirrors what `next build` does
# in production by running the same checks inside the dev container.
#
# Requires: web service from docker-compose.yml to be running.
# Skip in an emergency with:  git push --no-verify

set -e

if ! command -v docker >/dev/null 2>&1; then
  echo "✗ docker not found on PATH"
  exit 1
fi

# Ensure the web container is up.
if [ -z "$(docker compose ps so-snp-web --status running --quiet 2>/dev/null)" ]; then
  echo "✗ so-snp-web container is not running."
  echo "  Start it with: docker compose up -d"
  exit 1
fi

echo "→ pnpm typecheck (in so-snp-web container)"
docker compose exec -T so-snp-web pnpm typecheck

echo "→ pnpm lint (in so-snp-web container)"
docker compose exec -T so-snp-web pnpm lint

echo "✓ pre-push checks passed"
