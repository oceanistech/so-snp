# =============================================================================
# Signal S&P — environment variables
# =============================================================================
# Copy this file to .env.local for local development. Do NOT commit .env.local.
# Production values are set in the deployment platform, never in version control.
# Reference: platform-brd.md §4 Technology Stack.

# --- App ---------------------------------------------------------------------
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# --- Database (Postgres 16) --------------------------------------------------
# Prisma needs TWO URLs (see prisma/schema.prisma):
#   DATABASE_URL — runtime query traffic. In production this is the Supabase
#                  TRANSACTION POOLER (port 6543, ?pgbouncer=true).
#   DIRECT_URL   — schema migrations. In production this is the Supabase
#                  DIRECT CONNECTION (port 5432).
#
# === LOCAL (docker-compose stack) ============================================
# The web container reaches Postgres at the Compose service name `db` on its
# container-side port 5432. Local doesn't have a pooler — both URLs point at
# the same Postgres.
#
# ⚠ Next.js loads .env.local INSIDE the container too, overriding the
#   docker-compose `environment:` block. Keep these docker-internal.
#
# For host-pnpm dev (running `pnpm dev` outside docker), switch to:
#   DATABASE_URL=postgresql://snp:snp@localhost:55432/snp?schema=public
#   DIRECT_URL=postgresql://snp:snp@localhost:55432/snp?schema=public
DATABASE_URL=postgresql://snp:snp@db:5432/snp?schema=public
DIRECT_URL=postgresql://snp:snp@db:5432/snp?schema=public

# === PRODUCTION (Supabase) ===================================================
# Get these from: Supabase dashboard → Project Settings → Database →
#                 Connection string. Username is `postgres.PROJECT_REF`
#                 (with the dot — required by the pooler).
# Example (replace PROJECT_REF, PASSWORD, REGION):
#   DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#   DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Auth.js (NextAuth v5) ---------------------------------------------------
# Generate a secret with:  openssl rand -base64 32
AUTH_SECRET=replace-me-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# --- Mail (Nodemailer SMTP) --------------------------------------------------
# Default targets the FULL DOCKER STACK — Mailpit at the Compose service
# name `mail` on its container-side SMTP port `1025`.
#
# Mailpit web UI is exposed on the HOST at http://localhost:18025
# (host-port mapping from container 8025).
#
# For host-pnpm dev, switch MAIL_HOST/PORT to localhost:11025.
# In production point these at Mailgun (smtp.mailgun.org:587).
MAIL_HOST=mail
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Signal S&P <no-reply@signalsp.local>"

# --- Dev tooling -------------------------------------------------------------
# Set to "true" to expose /dev/mail-test endpoint. Always false in prod.
ENABLE_DEV_ROUTES=true
